# Overlay Electron — contoh variabel environment
# Salin jadi .env (di ~/.env atau folder proyek) lalu isi nilai yang sesuai.

# 9Router / LLM
NINEROUTER_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=Iris

# Voicevox
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=2

# Overlay server
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765
COMPANION_USER_NAME=Rover

# Hermes bridge
HERMES_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_TIMEOUT=120

# Token autentikasi /ws (buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))")
COMPANION_TOKEN=

# Folder user Windows dilihat dari WSL (ganti <user> dengan nama user Windows kamu)
HERMES_WIN_HOME=/mnt/c/Users/<user>
